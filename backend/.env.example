# JobTrack Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/jobtrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/jobtrack

# JWT Secret and Expiration
JWT_SECRET=jobtrack_super_secure_jwt_secret_dev_key_2025
JWT_EXPIRES_IN=30d

# Frontend CORS Origin
CORS_ORIGIN=http://localhost:5173
